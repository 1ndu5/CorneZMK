#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

#define BASE 0
#define NUM  1
#define NAV  2

/ {
    behaviors {
        // Mod-tap used for the home-row Shift keys (A and ;)
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q        &kp W  &kp E    &kp R  &kp T                              &kp UP                 &kp Y      &kp U  &kp I      &kp O    &kp P            &to NUM
&kp BSPC   &mt LSHFT A  &kp S  &kp D    &kp F  &kp G                   &kp LEFT  &kp RET   &kp RIGHT  &kp H      &kp J  &kp K      &kp L    &mt RSHFT SEMI   &kp SQT
&kp LCTRL  &kp Z        &kp X  &kp C    &kp V  &kp B       &none                 &kp DOWN             &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH         &kp RALT
                               &kp ESC  &mo NUM  &kp RET                                              &kp SPACE  &mo NAV  &kp LGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        num_layer {
            display-name = "NUMBERS";
            bindings = <
&trans    &kp N1     &kp N7  &kp N8         &kp N9          &kp PLUS                              &mmv MOVE_UP                       &kp LBRC   &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &to NAV
&kp DEL   &kp EQUAL  &kp N4  &kp N5         &kp N6          &kp MINUS               &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp RBRC   &kp DLLR   &kp PRCNT  &kp CARET &kp BSLH  &trans
&trans    &kp N0     &kp N1  &kp N2         &kp N3          &kp DOT     &trans                    &mmv MOVE_DOWN                     &kp GRAVE  &kp EXCL   &kp AT     &kp HASH  &trans    &trans
                             &trans         &mo BASE        &trans                                                                  &trans     &mo NAV    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        nav_layer {
            display-name = "NAVIGATION";
            bindings = <
&trans       &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0                          &mmv MOVE_UP                       &kp C_MUTE    &kp PG_DN  &kp UP     &kp PG_UP  &rgb_ug RGB_HUI  &to BASE
&caps_word   &kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1            &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp C_VOL_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_ON
&trans       &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_SEL 2  &trans                  &mmv MOVE_DOWN                     &kp C_VOL_UP  &kp C_PREV &kp C_PP   &kp C_NEXT &rgb_ug RGB_BRD  &rgb_ug RGB_EFF
                              &trans   &mo BASE &trans                                                                  &trans        &mo NUM    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
