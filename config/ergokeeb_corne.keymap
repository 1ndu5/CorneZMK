#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

#define BASE 0
#define NUM  1
#define NAV  2

/ {
    behaviors {
        // Hold-taps:
        //   Z|Shift and /|Shift (bottom-row corners) and F9|Shift on NAV: built-in &mt.
        //   Esc|NUM on the left middle thumb: built-in &lt.
        //   X|Alt and .|Alt: &slow_alt below.
        // Shift moved off A and ; (gen 5) to stop "am"/"an"/"a " roll misfires. The Shift
        // keys stay plain &mt: a tuned or guarded Shift breaks rolled capitals (tried and
        // reverted, see CLAUDE.md "Home-row-mod experiment").
        // Alt is always LALT: RALT acts as AltGr on UK/EU Windows layouts.

        // Alt is rarely used, so it has to be held deliberately:
        //   tap-preferred + 400 ms: only becomes Alt once held for 0.4 s, whatever else is pressed.
        //   require-prior-idle 150 ms: always a plain tap while typing ("next", "end. ").
        // The idle guard suits Alt (never needed mid-word); it would break Shift (capitals are).
        slow_alt: slow_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q        &kp W  &kp E    &kp R  &kp T                              &kp UP                 &kp Y      &kp U  &kp I      &kp O    &kp P            &caps_word
&kp BSPC   &kp A        &kp S              &kp D    &kp F  &kp G                   &kp LEFT  &kp RET   &kp RIGHT  &kp H      &kp J  &kp K      &kp L               &kp SEMI         &kp SQT
&kp LCTRL  &mt LSHFT Z  &slow_alt LALT X   &kp C    &kp V  &kp B       &none                 &kp DOWN             &kp N      &kp M  &kp COMMA  &slow_alt LALT DOT  &mt RSHFT FSLH   &kp RCTRL
                               &kp LGUI &lt NUM ESC &kp RET                                           &kp SPACE  &mo NAV  &kp LGUI
            >;
        };

        num_layer {
            display-name = "NUMBERS";
            bindings = <
&trans    &kp ASTRK  &kp N7  &kp N8         &kp N9          &kp PLUS                              &mmv MOVE_UP                       &kp LBKT   &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &none
&kp DEL   &kp EQUAL  &kp N4  &kp N5         &kp N6          &kp MINUS               &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp RBKT   &kp DLLR   &kp PRCNT  &kp CARET &none     &none
&trans    &kp N0     &kp N1  &kp N2         &kp N3          &kp DOT     &none                     &mmv MOVE_DOWN                     &kp GRAVE  &kp EXCL   &kp AT     &kp HASH  &kp BSLH  &trans
                             &trans         &none           &trans                                                                  &trans     &none       &trans
            >;
        };

        nav_layer {
            display-name = "NAVIGATION";
            bindings = <
&trans       &kp F1        &kp F2   &kp F3   &kp F4   &bt BT_SEL 0                      &rgb_ug RGB_BRI                          &kp C_MUTE    &kp HOME   &kp UP     &kp END    &kp PG_UP  &rgb_ug RGB_HUI
&kp DEL      &kp F5        &kp F6   &kp F7   &kp F8   &bt BT_SEL 1      &rgb_ug RGB_HUI  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &kp C_VOL_UP  &kp LEFT   &kp DOWN   &kp RIGHT  &kp PG_DN  &rgb_ug RGB_HUD
&trans       &mt LSHFT F9  &kp F10  &kp F11  &kp F12  &bt BT_SEL 2  &none              &rgb_ug RGB_BRD                          &kp C_VOL_DN  &kp C_PREV &kp C_PP   &kp C_NEXT &kp LALT   &kp RCTRL
                                    &trans   &none    &trans                                                                    &trans        &none       &trans
            >;
        };
    };
};
